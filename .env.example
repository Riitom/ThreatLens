# Optional local settings. PowerShell: $env:THREATLENS_SALT = "a-long-random-value"
# Generate a value locally with: python -c "import secrets; print(secrets.token_hex(32))"
THREATLENS_SALT=
# Local SQLite path. Defaults to instance/threatlens.db, or the temp folder on Vercel.
# THREATLENS_DB=instance/threatlens.db
# Optional, sends scanned URLs to Google's Safe Browsing service:
# SAFE_BROWSING_API_KEY=
# Optional, sends hostnames to crt.sh:
THREATLENS_CT_LOOKUP=0
